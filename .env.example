# Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clip_it_up
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/clip_it_up

# Redis (Celery broker + backend + pub/sub)
REDIS_URL=redis://localhost:6379/0

# Storage (S3 / MinIO / Cloudflare R2 compatible)
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=clip-it-up-videos
S3_REGION=us-east-1
S3_USE_SSL=false

# Auth (Clerk)
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_JWKS_URL=https://api.clerk.com/v1/jwks
CLERK_ISSUER=https://your-app.clerk.accounts.dev
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Auth Dev Bypass (Refused unless ENVIRONMENT=development)
DEV_AUTH_BYPASS=true
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEV_USER_EMAIL=dev@clipitup.local
DEV_CLERK_USER_ID=user_dev_bypass

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_SIZE_BYTES=5368709120
MULTIPART_THRESHOLD_BYTES=104857600
PRESIGNED_URL_EXPIRY_SECONDS=3600

# Pipeline Simulation Settings
PIPELINE_STAGE_DURATION_SECONDS=2
INJECT_RANDOM_FAILURE=false

# Monitoring (Optional)
SENTRY_DSN=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
