      "end_ms": 17000,
      "speaker": "Shaan Puri",
      "text": "Here is the secret to finding million dollar business opportunities before anyone else."
    },
    {
      "idx": 1,
      "start_ms": 17200,
      "end_ms": 29000,
      "speaker": "Shaan Puri",
      "text": "Look for terrible software that people are forced to use because it solves an excruciating pain point."
    },
    {
      "idx": 2,
      "start_ms": 29200,
      "end_ms": 42000,
      "speaker": "Shaan Puri",
      "text": "If an ugly forum or clunky Excel sheet is making two million dollars a year, that is your exact roadmap to build a modern SaaS."
    },
    {
      "idx": 3,
      "start_ms": 42200,
      "end_ms": 51000,
      "speaker": "Shaan Puri",
      "text": "Don't invent new demand. Modernize existing desperate demand."
    }
