  "segments": [
    {
      "idx": 0,
      "start_ms": 10000,
      "end_ms": 17000,
      "speaker": "Jason Calacanis",
      "text": "What is the actual defensible moat in the artificial intelligence stack?"
    },
    {
      "idx": 1,
      "start_ms": 17200,
      "end_ms": 25000,
      "speaker": "Chamath Palihapitiya",
      "text": "It is not the base model and it is not the raw compute."
    },
    {
      "idx": 2,
      "start_ms": 25200,
      "end_ms": 38000,
      "speaker": "Chamath Palihapitiya",
      "text": "The only sustainable moat is proprietary distribution and unique workflow integration where you own the end-user loop."
    },
    {
      "idx": 3,
      "start_ms": 38200,
      "end_ms": 50000,
      "speaker": "Chamath Palihapitiya",
      "text": "Commoditized intelligence means value flows directly to the application layer with sticky domain data."
    },
    {
      "idx": 4,
      "start_ms": 50200,
      "end_ms": 59000,
      "speaker": "Chamath Palihapitiya",
      "text": "And that is where the next hundred-billion-dollar companies will be created."
    },
    {
      "idx": 5,
      "start_ms": 65000,
      "end_ms": 72000,
      "speaker": "Jason Calacanis",
      "text": "Yeah, let me check our flight schedule for Miami conference next month."
    },
    {
      "idx": 6,
      "start_ms": 160000,
      "end_ms": 167000,
      "speaker": "Chamath Palihapitiya",
      "text": "Why did zero interest rates destroy venture capital discipline?"
    },
    {
      "idx": 7,
      "start_ms": 167200,
      "end_ms": 178000,
      "speaker": "Chamath Palihapitiya",
      "text": "When capital has zero cost, founders stop prioritizing unit economics and cash flow sustainability."
    },
    {
      "idx": 8,
      "start_ms": 178200,
      "end_ms": 189000,
      "speaker": "Chamath Palihapitiya",
      "text": "You end up subsidizing unprofitable customer acquisition instead of building genuine product differentiation."
    },
    {
      "idx": 9,
      "start_ms": 189200,
      "end_ms": 199000,
      "speaker": "Chamath Palihapitiya",
      "text": "When rates normalize, the businesses without real gross margins evaporate overnight."
    }
  ],
