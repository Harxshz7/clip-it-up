    {
      "idx": 0,
      "start_ms": 5000,
      "end_ms": 11000,
      "speaker": "Casey Neistat",
      "text": "Gear does not matter. Story is king."
    },
    {
      "idx": 1,
      "start_ms": 11200,
      "end_ms": 21000,
      "speaker": "Casey Neistat",
      "text": "I shot my most viewed videos on a cracked point-and-shoot camera held together with duct tape."
    },
    {
      "idx": 2,
      "start_ms": 21200,
      "end_ms": 34000,
      "speaker": "Casey Neistat",
      "text": "If you do not hook the viewer with a clear conflict in the first five seconds, having an eight-thousand dollar cinema lens will not save you."
    },
    {
      "idx": 3,
      "start_ms": 34200,
      "end_ms": 42000,
      "speaker": "Casey Neistat",
      "text": "Focus on emotional honesty and relentless pacing."
    }
  ],
