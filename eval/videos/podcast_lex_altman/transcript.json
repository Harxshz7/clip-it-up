  "word_count": 162,
  "segments": [
    {
      "idx": 0,
      "start_ms": 5000,
      "end_ms": 11000,
      "speaker": "Sam Altman",
      "text": "Why do people underestimate exponential technology curves?"
    },
    {
      "idx": 1,
      "start_ms": 11200,
      "end_ms": 22000,
      "speaker": "Sam Altman",
      "text": "The human brain is fundamentally wired for linear progress because in the ancestral environment nothing doubled every year."
    },
    {
      "idx": 2,
      "start_ms": 22200,
      "end_ms": 31000,
      "speaker": "Sam Altman",
      "text": "When you look at compute clusters growing by orders of magnitude, people think it must hit a wall tomorrow."
    },
    {
      "idx": 3,
      "start_ms": 31200,
      "end_ms": 42000,
      "speaker": "Sam Altman",
      "text": "In reality, the scaling laws have held steady for six consecutive years with no plateau in sight."
    },
    {
      "idx": 4,
      "start_ms": 42200,
      "end_ms": 50000,
      "speaker": "Sam Altman",
      "text": "And that is why the next five years will look unrecognizable compared to the last fifty."
    },
    {
      "idx": 5,
      "start_ms": 55000,
      "end_ms": 62000,
      "speaker": "Lex Fridman",
      "text": "Yeah, let's talk about the database architecture we had in 2015."
    },
    {
      "idx": 6,
      "start_ms": 62200,
      "end_ms": 70000,
      "speaker": "Lex Fridman",
      "text": "We had some Redis servers and standard PostgreSQL instances."
    },
    {
      "idx": 7,
      "start_ms": 120000,
      "end_ms": 126000,
      "speaker": "Lex Fridman",
      "text": "What is the single most important skill for a young engineer today?"
    },
    {
      "idx": 8,
      "start_ms": 126200,
      "end_ms": 133000,
      "speaker": "Sam Altman",
      "text": "It is not memorizing syntax or algorithms anymore."
    },
    {
      "idx": 9,
      "start_ms": 133200,
      "end_ms": 144000,
      "speaker": "Sam Altman",
      "text": "The superpower now is deep problem decomposition and taste in deciding what is worth building."
    },
    {
      "idx": 10,
      "start_ms": 144200,
      "end_ms": 155000,
      "speaker": "Sam Altman",
      "text": "If you can articulate clear intent to AI agents, you have the leverage of an entire engineering organization."
    },
    {
      "idx": 11,
      "start_ms": 155200,
      "end_ms": 163000,
      "speaker": "Sam Altman",
      "text": "That is the biggest leverage shift in the history of human work."
    }
  ],
