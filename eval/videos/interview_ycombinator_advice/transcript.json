    {
      "idx": 0,
      "start_ms": 7000,
      "end_ms": 14000,
      "speaker": "Michael Seibel",
      "text": "What kills more early-stage startups than competition or lack of funding?"
    },
    {
      "idx": 1,
      "start_ms": 14200,
      "end_ms": 22000,
      "speaker": "Michael Seibel",
      "text": "Co-founder disputes and misaligned long-term expectations."
    },
    {
      "idx": 2,
      "start_ms": 22200,
      "end_ms": 35000,
      "speaker": "Michael Seibel",
      "text": "Never pick a co-founder solely based on technical resume. Pick someone you have history working with through high-stress adversity."
    },
    {
      "idx": 3,
      "start_ms": 35200,
      "end_ms": 47000,
      "speaker": "Michael Seibel",
      "text": "Shared values and resilience under pressure matter ten times more than domain expertise."
    },
    {
      "idx": 4,
      "start_ms": 47200,
      "end_ms": 55000,
      "speaker": "Michael Seibel",
      "text": "And that is the number one predictor of startup survival."
    }
  ],
