  "segments": [
    {
      "idx": 0,
      "start_ms": 12000,
      "end_ms": 19000,
      "speaker": "Dwarkesh Patel",
      "text": "How do we know synthetic data won't cause model collapse at scale?"
    },
    {
      "idx": 1,
      "start_ms": 19200,
      "end_ms": 29000,
      "speaker": "Sholto Douglas",
      "text": "Model collapse only happens with uncurated recursive training on raw model garbage."
    },
    {
      "idx": 2,
      "start_ms": 29200,
      "end_ms": 43000,
      "speaker": "Sholto Douglas",
      "text": "When you use verifiable reward models and formal execution environments like compilers and math checkers, synthetic data actually outperforms human data."
    },
    {
      "idx": 3,
      "start_ms": 43200,
      "end_ms": 56000,
      "speaker": "Sholto Douglas",
      "text": "The model searches and verifies its own proofs, generating higher quality reasoning trajectories than typical internet text."
    },
    {
      "idx": 4,
      "start_ms": 56200,
      "end_ms": 64000,
      "speaker": "Sholto Douglas",
      "text": "That is the breakthrough that unlocks true self-improving reasoning."
    }
  ],
