  "segments": [
    {
      "idx": 0,
      "start_ms": 4000,
      "end_ms": 10000,
      "speaker": "Derek Muller",
      "text": "Is reality actually real when nobody is looking?"
    },
    {
      "idx": 1,
      "start_ms": 10200,
      "end_ms": 20000,
      "speaker": "Derek Muller",
      "text": "For centuries, physicists assumed particles had fixed properties regardless of measurement."
    },
    {
      "idx": 2,
      "start_ms": 20200,
      "end_ms": 33000,
      "speaker": "Derek Muller",
      "text": "Bell's theorem shattered this assumption by proving that no local hidden variable theory can explain quantum entanglement."
    },
    {
      "idx": 3,
      "start_ms": 33200,
      "end_ms": 45000,
      "speaker": "Derek Muller",
      "text": "Either the universe is non-local, or definite physical properties do not exist prior to observation."
    },
    {
      "idx": 4,
      "start_ms": 45200,
      "end_ms": 53000,
      "speaker": "Derek Muller",
      "text": "And that is the profound weirdness of the universe we live in."
    },
    {
      "idx": 5,
      "start_ms": 60000,
      "end_ms": 67000,
      "speaker": "Derek Muller",
      "text": "Now let us calibrate the detector with optical fiber cable."
    },
    {
      "idx": 6,
      "start_ms": 140000,
      "end_ms": 147000,
      "speaker": "Derek Muller",
      "text": "Why did Einstein call entanglement spooky action at a distance?"
    },
    {
      "idx": 7,
      "start_ms": 147200,
      "end_ms": 156000,
      "speaker": "Derek Muller",
      "text": "Because under special relativity, nothing can travel faster than the speed of light."
    },
    {
      "idx": 8,
      "start_ms": 156200,
      "end_ms": 168000,
      "speaker": "Derek Muller",
      "text": "Yet measuring one entangled particle instantaneously determines the state of its partner light-years away."
    },
    {
      "idx": 9,
      "start_ms": 168200,
      "end_ms": 178000,
      "speaker": "Derek Muller",
      "text": "This paradox forced us to rethink the very nature of spacetime and information."
    }
  ],
