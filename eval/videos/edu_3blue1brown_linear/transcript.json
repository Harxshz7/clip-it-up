  "segments": [
    {
      "idx": 0,
      "start_ms": 8000,
      "end_ms": 15000,
      "speaker": "Grant Sanderson",
      "text": "What does an eigenvalue actually represent in physical space?"
    },
    {
      "idx": 1,
      "start_ms": 15200,
      "end_ms": 27000,
      "speaker": "Grant Sanderson",
      "text": "When a linear transformation stretches and morphs space, most vectors get knocked off the line they spanned."
    },
    {
      "idx": 2,
      "start_ms": 27200,
      "end_ms": 39000,
      "speaker": "Grant Sanderson",
      "text": "Eigenvectors are the special axes that remain strictly on their original line, only scaled by the eigenvalue factor."
    },
    {
      "idx": 3,
      "start_ms": 39200,
      "end_ms": 52000,
      "speaker": "Grant Sanderson",
      "text": "Understanding this geometric invariant turns impenetrable matrix formulas into intuitive physical insights."
    }
  ],
