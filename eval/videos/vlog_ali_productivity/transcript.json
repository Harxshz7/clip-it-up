  "segments": [
    {
      "idx": 0,
      "start_ms": 6000,
      "end_ms": 13000,
      "speaker": "Ali Abdaal",
      "text": "Stop trying to manage your time and start managing your energy."
    },
    {
      "idx": 1,
      "start_ms": 13200,
      "end_ms": 23000,
      "speaker": "Ali Abdaal",
      "text": "Most people have four hours of high-cognitive output every day, not eight or ten."
    },
    {
      "idx": 2,
      "start_ms": 23200,
      "end_ms": 35000,
      "speaker": "Ali Abdaal",
      "text": "If you protect your top two hours in the morning for your highest-leverage project, you outperform 99% of your peers."
    },
    {
      "idx": 3,
      "start_ms": 35200,
      "end_ms": 42000,
      "speaker": "Ali Ali",
      "text": "That is the entire secret to exponential productivity."
    },
    {
      "idx": 4,
      "start_ms": 50000,
      "end_ms": 57000,
      "speaker": "Ali Abdaal",
      "text": "Anyway, let me check my calendar for next Tuesday afternoon."
    },
    {
      "idx": 5,
      "start_ms": 110000,
      "end_ms": 116000,
      "speaker": "Ali Abdaal",
      "text": "Why is consistency so much harder than intensity?"
    },
    {
      "idx": 6,
      "start_ms": 116200,
      "end_ms": 127000,
      "speaker": "Ali Abdaal",
      "text": "Because intensity feels heroic, while consistency feels boring and unrewarding in the short term."
    },
    {
      "idx": 7,
      "start_ms": 127200,
      "end_ms": 137000,
      "speaker": "Ali Abdaal",
      "text": "The people who win aren't the ones who work 14 hours once a month."
    },
    {
      "idx": 8,
      "start_ms": 137200,
      "end_ms": 147000,
      "speaker": "Ali Abdaal",
      "text": "They are the ones who show up for 90 minutes every single morning without fail."
    },
    {
      "idx": 9,
      "start_ms": 147200,
      "end_ms": 153000,
      "speaker": "Ali Abdaal",
      "text": "Compounding does the rest of the heavy lifting."
    }
  ],
