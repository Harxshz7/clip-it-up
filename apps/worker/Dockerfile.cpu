# Stage 1: Base builder with uv
FROM python:3.12-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

COPY packages/shared-py /app/packages/shared-py
COPY apps/worker /app/apps/worker

RUN uv venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN uv pip install -e /app/packages/shared-py
RUN uv pip install -e /app/apps/worker

# Stage 2: CPU Runtime image with FFmpeg
FROM python:3.12-slim AS runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r clipapp && useradd -r -g clipapp -d /app clipapp

COPY --from=builder /opt/venv /opt/venv
COPY packages/shared-py /app/packages/shared-py
COPY apps/worker /app/apps/worker

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONPATH="/app/packages/shared-py/src:/app/apps/worker/src:/app"

RUN chown -R clipapp:clipapp /app
USER clipapp

CMD ["celery", "-A", "worker.celery_app.celery_app", "worker", "-Q", "cpu,celery", "--loglevel=info", "--concurrency=2"]
